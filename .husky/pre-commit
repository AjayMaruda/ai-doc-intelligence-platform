

echo "🔍 Running staged file checks..."
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ lint-staged failed. Commit aborted."
  exit 1
fi

echo "🏗 Running TypeScript build validation..."
npm run build

if [ $? -ne 0 ]; then
  echo "❌ TypeScript build failed. Commit aborted."
  exit 1
fi

echo "✅ Pre-commit checks passed."