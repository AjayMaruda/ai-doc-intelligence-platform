{
  "openapi": "3.0.0",
  "info": {
    "title": "AI Document Intelligence Platform",
    "description": "Production-grade backend API for AI-powered document ingestion, async processing, and analytics.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/addUser": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "description": "",
        "responses": {
          "201": {
            "description": "User registered successfully"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterSchema"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/RegisterSchema"
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in an existing user",
        "description": "",
        "responses": {
          "200": {
            "description": "Login successful"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginSchema"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/LoginSchema"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "xml": {
          "name": "RegisterSchema"
        }
      },
      "LoginSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "xml": {
          "name": "LoginSchema"
        }
      }
    }
  }
}
